# ==============================================================================
# Super App Modular Monolith — Production Environment Template
# Copy this file to backend/.env (and never commit real secrets to Git).
# ==============================================================================

# --- Application ---
APP_NAME=Super App Ecosystem API
ENVIRONMENT=production
DEBUG=false

# --- Database (PostgreSQL Multi-Schema — Law 2) ---
# Schemas initialized by infra/postgres/init-schemas.sql:
#   identity_schema, wallet_schema, commerce_schema, media_ai_schema
USE_POSTGRES=true
POSTGRES_USER=superapp_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=super_app_db
DATABASE_URL=postgresql+asyncpg://superapp_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/super_app_db
DATABASE_URL_OVERRIDE=postgresql+asyncpg://superapp_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/super_app_db

# --- Distributed Event Bus / Cache (Redis Streams) ---
REDIS_URL=redis://redis:6379/0

# --- Perimeter Security (TrustedHostMiddleware) ---
# JSON array of allowed Host headers in production (replace with your VPS domain/IP)
ALLOWED_HOSTS=["api.example.com","localhost","127.0.0.1"]

# --- Authentication & JWT Rotation (Identity) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_64_CHAR_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Payment Gateway Webhook HMAC-SHA256 (Wallet) ---
WEBHOOK_HMAC_SECRET=CHANGE_ME_GENERATE_64_CHAR_WEBHOOK_HMAC_SECRET
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_GENERATE_64_CHAR_WEBHOOK_HMAC_SECRET

# --- Transactional Outbox Background Retry Worker ---
OUTBOX_RETRY_WORKER_ENABLED=true
OUTBOX_RETRY_INTERVAL_SECONDS=15.0

# --- Media AI Physical Artifacts Directory ---
# Mounted as persistent Docker volume 'media_outputs' in docker-compose.yml
MEDIA_OUTPUTS_DIR=/app/media_outputs
