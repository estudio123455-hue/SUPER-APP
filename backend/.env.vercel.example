# ==============================================================================
# Super App Modular Monolith — Vercel Serverless Environment Template
# Configure these variables in: Vercel Dashboard -> Project -> Settings -> Env Vars
# Never commit real secrets to Git.
# ==============================================================================

# --- Application ---
APP_NAME=Super App Ecosystem API
ENVIRONMENT=production
DEBUG=false

# --- Database (Optional External PostgreSQL: Neon / Supabase) ---
# Recommended for persistent multi-schema production (Law 2):
#   DATABASE_URL=postgresql+asyncpg://user:password@your-neon-or-supabase-host:5432/super_app_db
# If omitted on Vercel (VERCEL=1), the app automatically falls back to ephemeral writable SQLite:
#   sqlite+aiosqlite:////tmp/super_app_vercel.db
DATABASE_URL=

# --- Perimeter Security (TrustedHostMiddleware) ---
# JSON array including your Vercel preview/production domain(s)
ALLOWED_HOSTS=["*.vercel.app","localhost","127.0.0.1"]

# --- Authentication & JWT Rotation (Identity) ---
JWT_SECRET_KEY=CHANGE_ME_GENERATE_64_CHAR_VERCEL_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Payment Gateway Webhook HMAC-SHA256 (Wallet) ---
WEBHOOK_HMAC_SECRET=CHANGE_ME_GENERATE_64_CHAR_VERCEL_WEBHOOK_SECRET
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_GENERATE_64_CHAR_VERCEL_WEBHOOK_SECRET

# --- Serverless Outbox Policy ---
# Must remain false in Serverless Functions (use Cron or external worker for retries)
OUTBOX_RETRY_WORKER_ENABLED=false

# --- Ephemeral Writable Storage for Media AI Artifacts ---
MEDIA_OUTPUTS_DIR=/tmp/media_outputs

# --- Optional Distributed Event Bus (e.g. Upstash Redis) ---
REDIS_URL=
