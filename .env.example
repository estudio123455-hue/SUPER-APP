# ==============================================================================
# Super App Ecosystem — Production & Local Environment Variables (.env.example)
# ==============================================================================

# 1. Application Metadata
APP_NAME="Super App Ecosystem API"
APP_VERSION="0.1.0"
ENVIRONMENT="production"
DEBUG="false"

# 2. Database & Multi-Schema Isolation (Law 2: identity_schema, wallet_schema, commerce_schema, media_ai_schema)
USE_POSTGRES="true"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_strong_password_2026"
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_DB="super_app_db"
DATABASE_URL_OVERRIDE="postgresql+asyncpg://postgres:postgres_strong_password_2026@postgres:5432/super_app_db"
SQLITE_DB_PATH="sqlite+aiosqlite:///./super_app_dev.db"

# 3. Distributed Event Bus & Cache (Years 2-4 Scaling)
REDIS_URL="redis://redis:6379/0"

# 4. Identity & JWT Security
JWT_SECRET_KEY="CHANGE_ME_IN_PRODUCTION_SUPER_SECRET_KEY"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="30"
JWT_REFRESH_TOKEN_EXPIRE_DAYS="7"

# 5. Payment Gateway Webhook HMAC-SHA256 Secret (PSE / Nequi / Wompi)
PAYMENT_WEBHOOK_SECRET="CHANGE_ME_IN_PRODUCTION_WEBHOOK_HMAC_SECRET"
